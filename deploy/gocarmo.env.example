# GOCARMO Ride on a VPS: the second paid fallback.
#
# The original project's own path: Docker Compose with the bundled Caddy for
# HTTPS (docker-compose.yml, deploy/Caddyfile, docs/deploy.md). On the server:
#
#   cp deploy/gocarmo.env.example .env      # then read it once, top to bottom
#   make up
#
# `.env` stays on the server and is ignored by git: never commit it. Settings
# not listed here keep the defaults of .env.example. Lines marked [new] are
# settings added by GOCARMO Ride (docs/gocarmo-server-settings.md); the others
# are the original's.

# --- Name -------------------------------------------------------------------
OPENRADLR_SERVER_NAME="GOCARMO Ride"

# --- HTTPS by the bundled Caddy (ports 80 and 443 must reach this machine) ---
# DNS first: an `A` record `ride` pointing at the server's address, "DNS only".
COMPOSE_PROFILES=tls
OPENRADLR_DOMAIN=ride.gocarmo.com

# --- The game on its own host, shown by gocarmo.com --------------------------
OPENRADLR_PUBLIC_URL=https://ride.gocarmo.com
# [new] Sites that may show the game in a frame.
OPENRADLR_FRAME_ANCESTORS=https://gocarmo.com,https://www.gocarmo.com
# [new as its own setting] Pages that may open game connections and read
# /api/info from another origin. The game's own origin has to be in the list.
OPENRADLR_ALLOWED_ORIGINS=https://ride.gocarmo.com,https://gocarmo.com,https://www.gocarmo.com

# --- Client address ----------------------------------------------------------
# Caddy on this machine is the only way in: the server port stays on
# 127.0.0.1 and the address comes from Caddy's X-Forwarded-For.
OPENRADLR_HTTP_BIND=127.0.0.1
OPENRADLR_HTTP_PORT=8080
OPENRADLR_TRUST_PROXY=true
# [new] Only for a hosting platform's own proxy. Empty behind Caddy.
OPENRADLR_CLIENT_IP_HEADER=
OPENRADLR_MAX_CONNECTIONS_PER_IP=8

# --- Capacity: values from docs/gocarmo-server-settings.md ("2-core VPS") -----
# Measured with these: 200 to 230 MB of traffic per rider-hour, 6 % of one core
# with 50 riders. On a plan with metered traffic set
# OPENRADLR_MAX_VISIBLE_RIDERS=30 (100 MB per rider-hour).
OPENRADLR_MAX_PLAYERS=50
OPENRADLR_MAX_PADDLE_PLAYERS=20
OPENRADLR_MAX_VISIBLE_RIDERS=60
OPENRADLR_TARGET_RIDERS=12
OPENRADLR_BROADCAST_HZ=4
# [new] Bounds what a client that stopped reading can hold.
OPENRADLR_SEND_BUFFER_BYTES=131072

# --- Start screen ------------------------------------------------------------
OPENRADLR_ALLOW_SIMULATED_TRAINER=true
OPENRADLR_ALLOW_PADDLE_MODE=true

# --- Strava (off until both values are filled) -------------------------------
# From the Strava API application (docs/gocarmo-deploy.md, "Strava"). Type them
# on the server only.
OPENRADLR_STRAVA_CLIENT_ID=
OPENRADLR_STRAVA_CLIENT_SECRET=
# true while Strava limits how many athletes may connect to the application
# (one, then ten): the game then offers the .fit file first. false once Strava
# has approved more.
OPENRADLR_STRAVA_LIMITED=true
# Encrypts the stored Strava logins, which the `data` volume keeps across
# updates. Fill it before Strava is turned on: run `openssl rand -hex 32` on
# the server, paste the output here and never change it. Empty: logins are
# lost on every restart.
OPENRADLR_SECRET_KEY=

# --- Monitoring (optional) ---------------------------------------------------
# [new] /internal/metrics answers only "Authorization: Bearer <token>". Empty:
# only this machine itself may read it.
OPENRADLR_METRICS_TOKEN=

# --- OpenBikeNet: off ---------------------------------------------------------
OPENRADLR_OBN_URL=
# [new] Needed with the URL; agree it with the operator of that server.
OPENRADLR_OBN_APP_ID=
