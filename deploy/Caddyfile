# HTTPS reverse proxy for a public GOCARMO Ride server (the original project's file).
# Caddy fetches and renews certificates automatically and proxies WebSockets.

# The game: server, client and WebSocket (e.g. ride.gocarmo.com).
{$OPENRADLR_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	reverse_proxy server:8080
}
