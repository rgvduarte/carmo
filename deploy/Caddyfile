# HTTPS reverse proxy for public OpenRadlr servers.
# Caddy fetches and renews certificates automatically and proxies WebSockets.

# The app: game server, client and WebSocket (e.g. app.openradlr.com).
{$OPENRADLR_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	reverse_proxy server:8080
}
